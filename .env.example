# Pesosenpuoti — Cloudflare Pages environment variables
#
# This file is a REFERENCE ONLY. It is never read by the site or by
# Cloudflare — there is no .env file loaded at runtime. Set these as
# actual values in the Cloudflare dashboard instead:
#
#   Cloudflare dashboard → Workers & Pages → Pesosenpuoti project
#   → Settings → Environment variables → Add variable
#
# Set each one for both "Production" and "Preview" environments if you
# want preview deploys (e.g. from pull requests) to work the same way.
# Mark ADMIN_PASSWORD, RESEND_API_KEY, SESSION_SECRET and GITHUB_TOKEN
# as "Encrypt" / secret values, not plain text.

# --- Contact form (functions/api/contact.js, functions/_lib/resend.js) ---
RESEND_API_KEY=            # Resend API key (resend.com dashboard → API Keys)
CONTACT_TO_EMAIL=          # Where contact-form submissions get emailed to (Tuomo's inbox)
CONTACT_FROM_EMAIL=        # Sender address — must be on a domain verified in Resend

# --- Admin login (functions/api/login.js) ---
ADMIN_USERNAME=            # Tuomo's real login username
ADMIN_PASSWORD=            # Tuomo's real login password
SESSION_SECRET=            # Long random string used to sign the login session cookie

# --- Content publishing from the editor (functions/_lib/github.js) ---
GITHUB_TOKEN=              # GitHub personal access token with repo write access
GITHUB_REPO=LeoSuzu/Pesosenpuoti
GITHUB_BRANCH=main
